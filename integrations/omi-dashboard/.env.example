# Copy to .env.local for local development. Never commit the real file —
# it is gitignored. On Vercel, set these as Project → Settings →
# Environment Variables instead (see README.md); this file never needs real
# values in it.

# --- Omi Developer API (read-only) ------------------------------------------
# Create at app.omi.me → Developer → API Keys, with conversations:read only.
OMI_API_KEY=omi_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#OMI_API_BASE=https://api.omi.me

# --- Notion (read-only internal integration) --------------------------------
# Create at notion.so/my-integrations, then share the "Omi 会話ログ" database
# with it (database → "..." → Connections → add the integration).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# The "Omi 会話ログ" database id (paste the full URL; the dashboard extracts the id).
NOTION_DATABASE_ID=https://www.notion.so/xxxx/c2da9635e1984718a00c74ab4dd62d56

# Optional: a dedicated tasks / sales-knowledge database, if one exists
# (see integrations/meeting-digest's notion_tasks / notion_sales sinks).
# Leave unset — the dashboard derives tasks and ideas from the Omi API
# directly when these are absent.
#NOTION_TASKS_DATABASE_ID=
#NOTION_SALES_DATABASE_ID=

# --- Dashboard login ---------------------------------------------------------
# A single shared password — there is no user database. Pick something long;
# generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
DASHBOARD_PASSWORD=
# Signs the session cookie. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=

# --- Display --------------------------------------------------------------
#DASHBOARD_UTC_OFFSET_HOURS=9
#DASHBOARD_LOOKBACK_DAYS=60

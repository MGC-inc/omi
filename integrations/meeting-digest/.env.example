# Copy to .env and fill in. Then: chmod 600 .env
#
# .env is gitignored, and real environment variables always override it, so a
# one-off run can still do: OMI_API_KEY=... python -m meeting_digest

# --- required ---------------------------------------------------------------
# Create at app.omi.me -> Developer -> API Keys, with conversations:read only.
OMI_API_KEY=omi_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- where to deliver -------------------------------------------------------
# markdown, notion, slack, store (comma separated)
MD_SINKS=markdown

# How far back each ingest run looks.
MD_LOOKBACK_HOURS=24

# Omi records everything, including one-minute fragments and stray audio.
# Conversations shorter than this are skipped before their transcript is even
# fetched. 0 disables the filter.
MD_MIN_DURATION_MINUTES=5

# Which local day a conversation belongs to, and how times are displayed.
MD_UTC_OFFSET_HOURS=9

# --- Notion (only when 'notion' is in MD_SINKS) -----------------------------
#MD_NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
#MD_NOTION_DATABASE_ID=https://www.notion.so/xxxx/1234abcd...?v=...

# Column names, when the database does not use the English defaults. A column
# that does not exist is skipped, so only set the ones you actually have.
#MD_NOTION_PROP_DATE=日付
#MD_NOTION_PROP_CATEGORY=カテゴリ
#MD_NOTION_PROP_DURATION=長さ（分）
#MD_NOTION_PROP_OPEN_ACTIONS=未完了アクション
#MD_NOTION_PROP_OMI_ID=Omi ID

# Omi's raw transcript carries recognition noise, so it stays out of Notion by
# default. The full text is always in the local Markdown note.
#MD_NOTION_INCLUDE_TRANSCRIPT=false

# --- Slack (only when 'slack' is in MD_SINKS) -------------------------------
#MD_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- read-only HTTP API (only for `serve`) ----------------------------------
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#MD_API_TOKEN=
#MD_API_HOST=127.0.0.1
#MD_API_PORT=8787
